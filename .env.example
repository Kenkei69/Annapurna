# =================================================================
# Annapurna — Environment Configuration Template
# Independently maintained by Kenkei69
# =================================================================

# -----------------------------------------------------------------
# 1. Application URL
# -----------------------------------------------------------------
# Base URL used for internal API callbacks and notification webhooks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------
# 2. Google Cloud Platform & AI Services
# -----------------------------------------------------------------
# Google Cloud Project ID used for Vertex AI, BigQuery, Document AI, Firestore, & Translate
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Gemini / Generative AI API Key
GEMINI_API_KEY=your-gemini-api-key

# Path to GCP Service Account JSON keyfile (for local development)
GOOGLE_APPLICATION_CREDENTIALS=

# Alternatively, base64-encoded Service Account JSON (recommended for cloud deployments)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# (Optional) Document AI processor location (default: us)
GCP_DOCUMENTAI_LOCATION=us

# -----------------------------------------------------------------
# 3. Firebase Client Configuration
# -----------------------------------------------------------------
# Public client credentials for Firebase Auth and Firestore client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# Optional Google Analytics Measurement ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------
# 4. Email Alert Notifications (Gmail SMTP / Nodemailer)
# -----------------------------------------------------------------
SMTP_EMAIL=your-notifications@example.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=operations@example.com

# -----------------------------------------------------------------
# 5. WhatsApp Alert Notifications (Twilio)
# -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_TO=whatsapp:+1234567890
